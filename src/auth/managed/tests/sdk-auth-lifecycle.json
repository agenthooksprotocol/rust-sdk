  "lifecycle": [
    {
      "id": "cached-token-metadata-outage",
      "expect": "valid stored grant works without metadata HTTP, including a recreated provider"
    },
    {
      "id": "unbound-preemptive-unsafe-delivery",
      "expect": "known authorized binding sends stored token on first attempt; no 401/replay for upload or notification"
    },
    {
      "id": "unreplayed-challenge-prepares-next-attempt",
      "expect": "401/insufficient_scope on a notification or upload is not replayed but runs challenge handling (discovery, client-credentials acquisition, no login creation); the next operation sends a credential"
    },
    {
      "id": "unbound-lookup-anonymous-fallback",
      "expect": "up-front lookup never creates a pending login or performs discovery; only a store miss or host policy refusal sends an anonymous attempt"
    },
    {
      "id": "unbound-lookup-refreshes-expired-token",
      "expect": "up-front lookup refreshes an expired stored token non-interactively using cached authorization-server metadata"
    },
    {
      "id": "up-front-refresh-failure-no-anonymous-fallback",
      "expect": "known binding whose non-interactive refresh fails (transient, invalid_grant, missing cached metadata) fails the operation with that error, never sends anonymously"
    },
    {
      "id": "refresh-unknown-expiry-rotation",
      "expect": "rotated refresh credential persisted and reusable when expires_in absent"
    },
    {
      "id": "transient-refresh-failure",
      "expect": "5xx/non-OAuth/timeout retains credentials and returns retry, never permanent fabricated login state"
    },
    {
      "id": "refresh-invalid-grant-drops-tokens",
      "expect": "definitive interactive refresh invalid_grant removes access and refresh tokens when the record still holds the presented refresh token, and returns refresh_rejected"
    },
    {
      "id": "refresh-invalid-grant-stale-does-not-wipe",
      "expect": "invalid_grant for a refresh token already replaced by a newer record leaves the newer record intact"
    },
    {
      "id": "token-validation-failure-clears-in-flight",
      "expect": "invalid code-exchange response persists nothing; invalid refresh response persists only a valid rotated refresh token; no in-flight/refreshing state remains; returns provider_failed"
    },
    {
      "id": "client-credentials-transient-reissue",
      "expect": "retry can acquire with current client credentials without any human-login outcome"
    },
    {
      "id": "delivery-never-creates-pending-login",
      "expect": "delivery/credential/challenge paths return interaction_required without creating a pending login; only explicit prepare creates one"
    },
    {
      "id": "pending-login-fixed-lifetime",
      "expect": "pending login lifetime is host-configured and bounded (default 10 minutes), fixed at creation and survives the creating prepare's deadline or cancellation"
    },
    {
      "id": "pending-login-cross-process-completion",
      "expect": "a pending login created in one process completes from another process sharing the store"
    },
    {
      "id": "pending-login-reuse",
      "expect": "later prepare with same grant key and exact redirect whose requested+required scopes are within the pending scopes reuses it regardless of deadline or ceiling; completion records scopes bounded by the stored creating ceiling"
    },
    {
      "id": "pending-login-supersede",
      "expect": "later prepare with different grant key/redirect or scopes outside the pending scopes supersedes it; old callback fails interaction_required"
    },
    {
      "id": "pending-login-supersede-scope-union",
      "expect": "superseding login requests the union of old pending, new requested and new required scopes, intersected with the new ceiling; alternating callers converge without looping"
    },
    {
      "id": "pending-login-end-states",
      "expect": "a pending login ends exactly once by completion, supersede, cancel or expiry; later callbacks fail interaction_required"
    },
    {
      "id": "metadata-and-secret-rotation",
      "expect": "nonidentity metadata, token-endpoint auth method and runtime secret changes do not permanently fail stored session or persist secret"
    },
    {
      "id": "scope-ceiling-widening-keeps-grant",
      "expect": "widening the allowed ceiling finds the existing grant; effective scopes are granted scopes intersected with the current ceiling at use"
    },
    {
      "id": "scope-ceiling-narrowing-keeps-grant",
      "expect": "narrowing the ceiling hides scopes at use only; after a refresh under the narrow ceiling and widening it again the scope is still available"
    },
    {
      "id": "insufficient-scope-step-up",
      "expect": "only Bearer 403 insufficient_scope triggers allowed-scope step-up for the challenged operation"
    },
    {
      "id": "step-up-requirement-operation-scoped",
      "expect": "a challenge requirement is not persisted on the binding; later operations use the stored grant, including scopes added by step-up consent"
    },
    {
      "id": "step-up-required-scopes-round-trip",
      "expect": "interaction_required carries the validated required scopes; host passes them to prepare as explicit required scopes and consent includes them; access_denied reports them for diagnostics only"
    },
    {
      "id": "prepare-required-outside-ceiling-denied",
      "expect": "prepare with explicit required scopes outside the caller's ceiling fails access_denied"
    },
    {
      "id": "challenged-replay-once",
      "expect": "401 or Bearer 403 insufficient_scope on hooks/intercept, hooks/configuration or hooks/capabilities replays once with the same request id and body; second rejection fails"
    },
    {
      "id": "configured-preset-no-protected-resource-metadata",
      "expect": "explicit trusted preset uses issuer metadata and does not require PRM"
    },
    {
      "id": "explicit-shared-grant",
      "expect": "independently approved event/upload bindings share consent only with same explicit grant partition"
    },
    {
      "id": "invalid-callback-does-not-consume",
      "expect": "invalid state/redirect does not consume pending handle; subsequent valid callback can complete once"
    },
    {
      "id": "loopback-redirect",
      "expect": "literal IPv4/IPv6 loopback HTTP redirect accepted; remote HTTP rejected"
    },
    {
      "id": "narrowed-refresh-scope-inheritance",
      "expect": "initial request read+write grants read; refresh with no scope stays read and cannot fabricate write"
    },
    {
      "id": "scope-challenge-without-required-scope",
      "expect": "insufficient_scope without scope cannot invent permissions; require explicit host requirement or deny"
    },
    {
      "id": "refresh-broadening-scope-ignored",
      "expect": "initial read+write request grants read; refresh response scoped read write records read only, persists rotated refresh and stays usable; a write-requiring operation fails access_denied"
    },
    {
      "id": "extra-granted-scope-ignored",
      "expect": "response scopes outside the allowed ceiling (e.g. openid, offline_access) are dropped from the recorded grant, not an error"
    }
  ]
}
